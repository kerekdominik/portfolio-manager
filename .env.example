# Copy to .env (never commit it) and fill in the values.

# Database (the postgres container is created with these)
DB_USERNAME=portfolio
DB_PASSWORD=change-me

# Signs the login tokens: at least 64 bytes, base64. Generate with: openssl rand -base64 64
JWT_SECRET_KEY=

# Port the app is published on (open http://<host>:FRONTEND_PORT)
FRONTEND_PORT=8082
# Public address of the app (used after an OAuth2 login)
APP_FRONTEND_URL=http://localhost:8082

# Optional: stock prices (free key from alphavantage.co). Without it the stock list import is skipped.
ALPHAVANTAGE_API_KEY=

# Optional: Google sign-in. Leave empty to use e-mail and password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: which published image version to run (default: latest)
# IMAGE_TAG=latest
